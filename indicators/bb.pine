//@version=5
indicator("Bollinger Bands", shorttitle="BB", overlay=true)
length = input.int(20, "Length", minval=1)
mult = input.float(2.0, "StdDev", minval=0.1, step=0.1)
src = input.source(close, "Source")
[basis, upper, lower] = ta.bb(src, length, mult)
plot(basis, "Basis", color=color.orange)
p1 = plot(upper, "Upper", color=color.purple)
p2 = plot(lower, "Lower", color=color.purple)
fill(p1, p2, color=color.new(color.purple, 90))
