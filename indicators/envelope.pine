//@version=5
indicator("Moving Average Envelope", shorttitle="Env", overlay=true)
length = input.int(20, "Length", minval=1)
percent = input.float(2.5, "Percent", minval=0.1, step=0.1)
src = input.source(close, "Source")
basis = ta.sma(src, length)
k = percent / 100.0
p1 = plot(basis * (1 + k), "Upper", color=color.teal)
p2 = plot(basis * (1 - k), "Lower", color=color.teal)
plot(basis, "Basis", color=color.orange)
fill(p1, p2, color=color.new(color.teal, 94))
