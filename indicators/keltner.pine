//@version=5
indicator("Keltner Channels", shorttitle="KC", overlay=true)
length = input.int(20, "Length", minval=1)
mult = input.float(2.0, "Multiplier", minval=0.1, step=0.1)
useTR = input.bool(true, "Use True Range")
src = input.source(close, "Source")
[mid, upper, lower] = ta.kc(src, length, mult, useTR)
plot(mid, "Basis", color=color.blue)
p1 = plot(upper, "Upper", color=color.blue)
p2 = plot(lower, "Lower", color=color.blue)
fill(p1, p2, color=color.new(color.blue, 92))
