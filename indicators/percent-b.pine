//@version=5
indicator("Bollinger %B", shorttitle="%B", overlay=false)
length = input.int(20, "Length", minval=1)
mult = input.float(2.0, "StdDev", minval=0.1, step=0.1)
src = input.source(close, "Source")
[basis, upper, lower] = ta.bb(src, length, mult)
plot((src - lower) / (upper - lower), "%B", color=color.purple)
h1 = hline(1, "Upper")
h2 = hline(0, "Lower")
fill(h1, h2, color=color.new(color.purple, 94))
