//@version=5
indicator("Stochastic RSI", shorttitle="StochRSI", overlay=false)
rsiLen = input.int(14, "RSI Length", minval=1)
stochLen = input.int(14, "Stochastic Length", minval=1)
smoothK = input.int(3, "%K Smoothing", minval=1)
smoothD = input.int(3, "%D Smoothing", minval=1)
src = input.source(close, "Source")
r = ta.rsi(src, rsiLen)
k = ta.sma(ta.stoch(r, r, r, stochLen), smoothK)
d = ta.sma(k, smoothD)
plot(k, "%K", color=color.blue)
plot(d, "%D", color=color.orange)
h1 = hline(80, "Upper")
h2 = hline(20, "Lower")
fill(h1, h2, color=color.new(color.blue, 94))
